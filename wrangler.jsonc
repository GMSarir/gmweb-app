{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gmweb-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c0dbac87-55bb-4fd4-a3be-dd6de0c93049","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f1797ce2efa6418da858886b69967041" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
